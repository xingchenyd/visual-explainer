  "scenes": [
    {
      "id": "intro",
      "title": "多算子模拟退火",
      "learningBeat": "多种改法，共用一套接受规则",
      "narration": "多算子模拟退火怎样优化一条路线？我们用八座城市，看清三种改法、概率接受，以及降温。这里的多算子，指多种邻域操作，不是多个优化目标。",
      "audioDuration": 15.531337868480726,
      "start": 0,
      "duration": 16.666666666666668
    },
    {
      "id": "problem",
      "title": "先明确：什么叫更好的解？",
      "learningBeat": "目标：访问每座城市一次，再回到起点",
      "narration": "一条解，就是城市的访问顺序。我们把相邻城市的欧氏距离相加，包括最后回到起点的一段。总路程越短，解就越好。",
      "audioDuration": 12.692335600907029,
      "start": 16.666666666666668,
      "duration": 13.833333333333334
    },
    {
      "id": "swap",
      "title": "算子 1：交换两个位置",
      "learningBeat": "两座城市互换，其余访问位置保留",
      "narration": "第一种改法是交换。选中顺序里的两座城市，把它们的位置互换。注意，改变的是访问顺序，地图上的城市坐标并没有移动。",
      "audioDuration": 12.925895691609977,
      "start": 30.5,
      "duration": 14.041666666666666
    },
    {
      "id": "insert",
      "title": "算子 2：抽出，再插入",
      "learningBeat": "一座城市换位置，中间城市顺次移动",
      "narration": "第二种改法是插入。把一座城市从原位置抽出，再插到另一个位置；夹在中间的城市顺次移动。它探索的路线，和简单交换不同。",
      "audioDuration": 13.342312925170068,
      "start": 44.541666666666664,
      "duration": 14.458333333333334
    },
    {
      "id": "2-opt",
      "title": "算子 3：反转一段路径",
      "learningBeat": "对称距离下：断开两条边，再重新连接",
      "narration": "第三种是二步优化，也叫二 opt。切断区段两端的连接，把区段内部的访问顺序反过来，再接回去。在这个对称距离例子中，内部边的长度不变，两端连接发生改变。",
      "audioDuration": 16.83356009070295,
      "start": 59.0,
      "duration": 17.958333333333332
    },
    {
      "id": "choose",
      "title": "每一轮，先选一个算子",
      "learningBeat": "本例固定等概率：各 1/3",
      "narration": "多算子并不意味着每轮都把三种改法做一遍。本例每轮等概率抽取一种，生成一个候选解。算子负责怎样改变路线，接受规则负责要不要走过去。",
      "audioDuration": 14.855238095238095,
      "start": 76.95833333333333,
      "duration": 15.958333333333334
    },
    {
      "id": "improve",
      "title": "候选更短：直接接受",
      "learningBeat": "Δ = 候选路程 − 当前路程",
      "narration": "看一次真实迭代。当前路程是 58.07，候选是 44.42。差值小于零，说明路线缩短了，所以直接接受。相等的候选也接受。",
      "audioDuration": 15.002675736961452,
      "start": 92.91666666666666,
      "duration": 16.125
    },
    {
      "id": "worse",
      "title": "候选更长：也可能接受",
      "learningBeat": "给跳出局部最优，留一个机会",
      "narration": "再看一次真实迭代。候选变差了 9.70。按当前温度计算，接受概率约为百分之 29。随机数小于这个概率，所以本轮仍然接受。接受较差解能帮助探索，但不保证下一步就会改善。",
      "audioDuration": 19.965668934240362,
      "start": 109.04166666666666,
      "duration": 21.083333333333332
    },
    {
      "id": "cool",
      "title": "温度越低，越不愿意冒险",
      "learningBeat": "同样的变差幅度，不同的接受概率",
      "narration": "对于同样的正差值，接受概率是 e 的负差值除以温度次方。温度高，更愿意接受变差；温度低，更谨慎。本例每轮把温度乘以零点九九，逐渐从探索转向收敛。",
      "audioDuration": 16.869024943310656,
      "start": 130.125,
      "duration": 18.0
    },
    {
      "id": "run",
      "title": "把 600 轮，连起来看",
      "learningBeat": "青色：当前解　金色：历史最好解",
      "narration": "现在加速播放六百轮。当前路程会因为接受较差解而上下波动。历史最好值只在发现更短路线时更新，所以不会上升。降温后，路线逐渐稳定。",
      "audioDuration": 15.752154195011338,
      "start": 148.125,
      "duration": 16.875
    },
    {
      "id": "summary",
      "title": "带走这一条主线",
      "learningBeat": "多种邻域 + 概率接受 + 降温 + 最优记录",
      "narration": "最后返回历史最好解，而不是简单返回最后停留的解。记住：多种算子扩大探索方式，概率接受允许暂时绕路，降温逐渐收紧选择。有限次运行不保证全局最优，效果仍要靠多次实验检验。",
      "audioDuration": 19.749251700680272,
      "start": 165.0,
      "duration": 20.875
    }
  ],
  "duration": 185.875
}