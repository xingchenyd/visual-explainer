{
  "version": "0.1",
  "lessonId": "matrix-multiplication",
  "title": "为什么矩阵乘法不是对应元素相乘？",
  "goal": "看懂一个输出格如何由一行与一列配对、相乘、累加得到。",
  "objects": {
    "A": {
      "type": "matrix",
      "role": "input",
      "data": [
        [
          1,
          2,
          3
        ],
        [
          4,
          5,
          6
        ]
      ]
    },
    "B": {
      "type": "matrix",
      "role": "weight",
      "data": [
        [
          1,
          2
        ],
        [
          3,
          4
        ],
        [
          5,
          6
        ]
      ]
    },
    "C": {
      "type": "matrix",
      "role": "result"
    }
  },
  "bindings": {
    "product": {
      "op": "matmul",
      "left": "A",
      "right": "B"
    }
  },
  "scenes": [
    {
      "id": "why-compose",
      "action": "compare",
      "duration": 8,
      "learningBeat": "矩阵乘法，连接两段关系",
      "narration": "A 把配料映射到套餐，B 把营养映射到配料。连接中间的配料，才能算出每份套餐的营养。",
      "binding": "product"
    },
    {
      "id": "focus-0-0",
      "action": "focus",
      "duration": 5,
      "learningBeat": "选一行，再选一列",
      "narration": "A 第 1 行表示一份套餐用了哪些配料；B 第 1 列表示每种配料提供多少同一种营养。",
      "binding": "product",
      "cell": [
        0,
        0
      ]
    },
    {
      "id": "pair-0-0",
      "action": "pairCells",
      "duration": 7,
      "learningBeat": "沿共同维度，一项一项配对",
      "narration": "相同配料才配对：套餐中的用量，乘以这份配料的营养含量。",
      "binding": "product",
      "cell": [
        0,
        0
      ]
    },
    {
      "id": "sum-0-0",
      "action": "accumulate",
      "duration": 9,
      "learningBeat": "把每种配料的贡献加起来",
      "narration": "每个乘积是一条中间路径的贡献。所有配料的贡献相加，得到这个输出格。",
      "binding": "product",
      "cell": [
        0,
        0
      ]
    },
    {
      "id": "write-0-0",
      "action": "writeResult",
      "duration": 4,
      "learningBeat": "将总和写回对应输出格",
      "narration": "结果写入 C 的第 1 行、第 1 列；它代表这份套餐的这一种营养总量。",
